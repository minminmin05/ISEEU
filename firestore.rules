rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(code) {
      return signedIn() &&
        exists(/databases/$(database)/documents/families/$(code)/members/$(request.auth.uid));
    }

    function isVisibleMember(code, uid) {
      return get(/databases/$(database)/documents/families/$(code)/members/$(uid)).data.isVisible == true;
    }

    match /families/{code} {
      // Needed so an unjoined client can validate a code during create/join — never lets codes be enumerated (see "allow list: false").
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly(['createdAt', 'createdBy']);
      allow update, delete: if false;

      match /members/{uid} {
        // "read" covers both get() and list() — this is what lets the roster listener query the whole collection.
        allow read: if isMember(code);

        allow create: if signedIn() && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(
               ['displayName', 'avatarColor', 'avatarPhotoBase64', 'isVisible', 'activityStatus', 'profileUpdatedAt'])
          && request.resource.data.isVisible is bool
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 40
          && (!('avatarPhotoBase64' in request.resource.data) || request.resource.data.avatarPhotoBase64.size() < 400000);

        allow update: if signedIn() && (
          // owner may update their own allowed fields
          (uid == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(
              ['displayName', 'avatarColor', 'avatarPhotoBase64', 'isVisible', 'activityStatus',
               'currentPinId', 'currentPinEnteredAt', 'profileUpdatedAt', 'refreshRequestedAt']) &&
            request.resource.data.displayName is string &&
            request.resource.data.displayName.size() > 0 &&
            request.resource.data.displayName.size() <= 40 &&
            (!('avatarPhotoBase64' in request.resource.data) || request.resource.data.avatarPhotoBase64.size() < 400000))
          ||
          // any other family member may touch ONLY refreshRequestedAt, and only on a currently-visible member
          (uid != request.auth.uid && isMember(code) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['refreshRequestedAt']) &&
            resource.data.isVisible == true)
        );

        allow delete: if false;

        match /location/current {
          // This is where the privacy toggle is actually enforced: hidden members' location is
          // unreadable server-side, not just hidden client-side.
          allow read: if signedIn() &&
            (uid == request.auth.uid || (isMember(code) && isVisibleMember(code, uid)));

          allow write: if signedIn() && uid == request.auth.uid
            && request.resource.data.keys().hasOnly(['lat', 'lng', 'timestamp'])
            && request.resource.data.lat is number
            && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
            && request.resource.data.lng is number
            && request.resource.data.lng >= -180 && request.resource.data.lng <= 180;

          allow delete: if false;
        }

        match /history/{entryId} {
          // Same visibility rule as location/current: hidden members' history is unreadable
          // server-side to anyone but themselves.
          allow read: if signedIn() &&
            (uid == request.auth.uid || (isMember(code) && isVisibleMember(code, uid)));

          // Append-only — no update/delete, matching the client's write pattern (it only ever add()s).
          allow create: if signedIn() && uid == request.auth.uid
            && request.resource.data.keys().hasOnly(['lat', 'lng', 'timestamp'])
            && request.resource.data.lat is number
            && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
            && request.resource.data.lng is number
            && request.resource.data.lng >= -180 && request.resource.data.lng <= 180;

          allow update, delete: if false;
        }

      }

      match /pins/{pinId} {
        // Saved places (Life360-style "Home"/"School") — family-scoped, not tied to one member.
        allow read: if isMember(code);

        allow create: if isMember(code)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.keys().hasOnly(['name', 'lat', 'lng', 'radiusMeters', 'type', 'createdBy', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && request.resource.data.lat is number
          && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
          && request.resource.data.lng is number
          && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
          && request.resource.data.radiusMeters is number
          && request.resource.data.radiusMeters > 0 && request.resource.data.radiusMeters <= 2000
          && request.resource.data.type in ['home', 'school', 'work', 'other'];

        // Any family member may remove a place — same trust model as touching another
        // member's refreshRequestedAt: everyone in a ≤10-person family is already trusted.
        allow update: if false;
        allow delete: if isMember(code);
      }
    }
  }
}
